module alu

input:
    a [WIDTH bits]
    b [WIDTH bits]
    alu_op [5 bits]

output:
    result [WIDTH bits]

wires:
    sub_res [WIDTH bits]
    and_res [WIDTH bits]
    or_res [WIDTH bits]
    xor_res [WIDTH bits]
    sll_res [WIDTH bits]
    srl_res [WIDTH bits]
    sra_res [WIDTH bits]
    slt_res [WIDTH bits]
    sltu_res [WIDTH bits]

    shift_amt [6 bits]
    shift_amt_w [5 bits]

    a_lo [32 bits]
    b_lo [32 bits]
    addw_res [32 bits]
    subw_res [32 bits]
    sllw_res [32 bits]
    srlw_res [32 bits]
    sraw_res [32 bits]

logic:
    connect shift_amt = b[bits 5-0]
    connect shift_amt_w = b[bits 4-0]
    connect a_lo = a[bits 31-0]
    connect b_lo = b[bits 31-0]

    connect sub_res = a - b
    connect and_res = a bitwAnd b
    connect or_res = a bitwOr b
    connect xor_res = a bitwXor b
    connect sll_res = a <shf shift_amt
    connect srl_res = a shf> shift_amt
    connect sra_res = signed(a) shf> shift_amt
    connect slt_res = signed(a) < signed(b)
    connect sltu_res = a < b

    connect addw_res = signed(a_lo) + signed(b_lo)
    connect subw_res = signed(a_lo) - signed(b_lo)
    connect sllw_res = a_lo <shf shift_amt_w
    connect srlw_res = a_lo shf> shift_amt_w
    connect sraw_res = signed(a_lo) shf> shift_amt_w

    connect result = mux(alu_op)
        (a + b),
        sub_res,
        and_res,
        or_res,
        xor_res,
        sll_res,
        srl_res,
        sra_res,
        slt_res,
        sltu_res,
        b,
        signed(addw_res),
        signed(subw_res),
        0,
        signed(sllw_res),
        signed(srlw_res),
        signed(sraw_res)
        fallbackVal: 0

end module
