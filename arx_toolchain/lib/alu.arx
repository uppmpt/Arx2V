module alu

input:
    a [WIDTH bits]
    b [WIDTH bits]
    alu_op [4 bits]

output:
    result [WIDTH bits]

wires:
    sub_res [WIDTH bits]
    and_res [WIDTH bits]
    or_res [WIDTH bits]
    xor_res [WIDTH bits]
    sll_res [WIDTH bits]
    srl_res [WIDTH bits]
    sra_res [WIDTH bits]
    slt_res [WIDTH bits]
    sltu_res [WIDTH bits]
    
    shift_amt [6 bits]

logic:
    connect shift_amt = b[bits 5-0]

    # Cálculos paralelos
    connect sub_res = a - b
    connect and_res = a bitwAnd b
    connect or_res = a bitwOr b
    connect xor_res = a bitwXor b
    connect sll_res = a <shf shift_amt
    connect srl_res = a shf> shift_amt
    
    # SRA: Shift aritmético usa o cast signed()
    connect sra_res = signed(a) shf> shift_amt
    
    # SLT e SLTU: Comparações geram 1 bit, o compilador auto-estende para WIDTH
    connect slt_res = signed(a) < signed(b)
    connect sltu_res = a < b

    # Multiplexador da ALU (evita aninhamento proibido)
    connect result = mux(alu_op)
        (a + b),      # 0: ADD
        sub_res,      # 1: SUB
        and_res,      # 2: AND
        or_res,       # 3: OR
        xor_res,      # 4: XOR
        sll_res,      # 5: SLL
        srl_res,      # 6: SRL
        sra_res,      # 7: SRA
        slt_res,      # 8: SLT
        sltu_res,     # 9: SLTU
        b,            # 10: PASS_B (para LUI e AUIPC)
        0             # 11: Reservado
        fallbackVal: 0

end module
