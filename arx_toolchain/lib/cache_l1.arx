module cache_l1

input:
    clk
    rst
    cpu_addr [64 bits]
    cpu_re [1 bit]
    cpu_we [1 bit]
    cpu_wdata [WIDTH bits]
    
    mem_rdata [WIDTH bits]
    mem_ready [1 bit]

output:
    cpu_rdata [WIDTH bits]
    cpu_ready [1 bit]
    
    mem_addr [64 bits]
    mem_re [1 bit]
    mem_we [1 bit]
    mem_wdata [WIDTH bits]

arrays:
    cache_data [CACHE_LINES] [WIDTH bits]
    cache_tag [CACHE_LINES] [TAG_BITS bits]
    cache_valid [CACHE_LINES] [1 bit]
    cache_dirty [CACHE_LINES] [1 bit]

wires:
    tag [TAG_BITS bits]
    index [INDEX_BITS bits]
    hit [1 bit]
    zero_offset [2 bits]

logic:
    # O fatiamento agora usa o INDEX_BITS (assumindo que TAG + INDEX + 2 = 64)
    connect tag = cpu_addr[bits 63-10]  # Se INDEX=8, pega 54 bits. (Se o seu index for 6, ajuste aqui para 63-8)
    connect index = cpu_addr[bits 9-2]  # Pega 8 bits
    connect zero_offset = 0
    connect hit = (cache_valid[index] == 1) logAnd (cache_tag[index] == tag)

states:
    IDLE
    HIT
    FETCH
    WRITE_BACK

behavior on clk (posSen) or rst (posSen):
    if (rst == 1):
        state = IDLE
        cpu_ready = 0
        mem_re = 0
        mem_we = 0
    else:
        when state:
            IDLE:
                if (cpu_re == 1) logOr (cpu_we == 1):
                    if (hit == 1):
                        state = HIT
                    else:
                        if (cache_dirty[index] == 1):
                            state = WRITE_BACK
                        else:
                            state = FETCH
                        
            HIT:
                if (cpu_re == 1):
                    cpu_rdata = cache_data[index]
                else:
                    cache_data[index] = cpu_wdata
                    cache_dirty[index] = 1
                cpu_ready = 1
                if (cpu_re == 0 logAnd cpu_we == 0):
                    state = IDLE
                    cpu_ready = 0
                    
            FETCH:
                mem_addr = conc(zero_offset, tag, index)
                mem_re = 1
                if (mem_ready == 1):
                    cache_data[index] = mem_rdata
                    cache_tag[index] = tag
                    cache_valid[index] = 1
                    cache_dirty[index] = 0
                    mem_re = 0
                    state = HIT
                    
            WRITE_BACK:
                mem_addr = conc(zero_offset, cache_tag[index], index)
                mem_wdata = cache_data[index]
                mem_we = 1
                if (mem_ready == 1):
                    mem_we = 0
                    state = FETCH
            fallbackVal:
                state = IDLE
end behavior

end module
