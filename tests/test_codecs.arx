module TestCodecs
input:
  sel [3 bits]
  in_one_hot [8 bits]
  in_vec [8 bits]
output:
  out_dec [8 bits]
  out_enc [3 bits]
  out_high [3 bits]
  out_low [3 bits]
logic:
  connect out_dec = decode(sel)
  connect out_enc = encode(in_one_hot)
  connect out_high = highPencode(in_vec)
  connect out_low = lowPencode(in_vec)
end module
