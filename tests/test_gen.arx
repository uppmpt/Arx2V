module FullAdder
input:
  a [1 bit]
  b [1 bit]
  cin [1 bit]
output:
  sum [1 bit]
  cout [1 bit]
logic:
  connect sum = a bitwXor b bitwXor cin
  connect cout = (a bitwAnd b) bitwOr (cin bitwAnd (a bitwXor b))
end module

module Adder8
input:
  a [8 bits]
  b [8 bits]
  cin [1 bit]
output:
  sum [8 bits]
  cout [1 bit]
wires:
  c [9 bits]
logic:
  connect c[bit 0] = cin
  for i in 0..7:
    instance FullAdder as fa[i]:
      a = a[bit i]
      b = b[bit i]
      cin = c[bit i]
      sum = sum[bit i]
      cout = c[bit i+1]
    end instance
  connect cout = c[bit 8]
end module
