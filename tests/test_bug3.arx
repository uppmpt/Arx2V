module ComplexALU
input:
  clk
  rst
  a [32 bits] signed
  b [32 bits] signed
  op [2 bits]
output:
  res [32 bits] signed
wires:
  sum [32 bits] signed
  chopped [31 bits]
logic:
  connect sum = a + b
  # ERRO AQUI: O bit 32 não existe em um sinal de 32 bits!
  connect chopped = sum[bits 32-2]
behavior on clk (posSen) or rst (negSen):
  if rst == 0:
    res = 0
  else:
    when op:
      0:
        res = sum
      fallbackVal:
        res = 0
end behavior
end module
