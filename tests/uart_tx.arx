module UART_TX
input:
  clk
  rst
  tx_start [1 bit]
  tx_data [8 bits]
output:
  tx [1 bit]
  tx_busy [1 bit]
wires:
  baud_cnt [10 bits]
  bit_cnt [4 bits]
  shift_reg [10 bits]
  start_bit [1 bit]
  stop_bit [1 bit]
logic:
  # Frame: [start=0] [data 8bits LSB-first] [stop=1]
  connect start_bit = 0
  connect stop_bit = 1
  connect tx_busy = (bit_cnt != 0)
  
  # tx = shift_reg[0] durante tx, 1 durante idle
  connect tx = mux(bit_cnt == 0) shift_reg[bit 0] fallbackVal: 1
  
behavior on clk (posSen) or rst (negSen):
  if rst == 0:
    baud_cnt = 0
    bit_cnt = 0
    shift_reg = 0
  else:
    if tx_start == 1:
      # conc é LSB-first: {stop, data, start}
      shift_reg = conc(start_bit, tx_data, stop_bit)
      bit_cnt = 10
      baud_cnt = 0
    else if bit_cnt != 0:
      if baud_cnt == 7:
        baud_cnt = 0
        bit_cnt = bit_cnt - 1
        shift_reg = shift_reg shf> 1
      else:
        baud_cnt = baud_cnt + 1
end behavior
end module
