module alu
input:
  a [32 bits]
  b [32 bits]
  alu_op [3 bits]
output:
  result [32 bits]
wires:
  sub_res [32 bits]
logic:
  connect sub_res = a - b
  connect result = mux(alu_op)
    (a + b),
    sub_res,
    (a bitwAnd b),
    (a bitwOr b),
    (a bitwXor b),
    sub_res[31],
    0,
    0
    fallbackVal: 0
end module
