module mac_array

input:
  forInput a [4] [8 bits]
  forInput b [4] [8 bits]

output:
  result [32 bits]

wires:
  forWire mult [4] [32 bits]

logic:
  # _All expande para _0, _1, _2, _3 em cada iteração do for
  for i in 0..3:
    connect mult_All = a_All * b_All

  connect result = mult_0 + mult_1 + mult_2 + mult_3

end module
