module uart_tx

input:
    clk
    rst
    tx_start [1 bit]
    tx_data [8 bits]

output:
    tx [1 bit]
    tx_busy [1 bit]

wires:
    state [2 bits]
    div_count [8 bits]
    bit_count [4 bits]
    shift_reg [8 bits]

logic:
    # tx_busy = 0 quando IDLE, 1 quando transmitindo
    connect tx_busy = mux(state) 0, 1, 1, 1 fallbackVal: 1

    # tx = baseado no estado atual
    connect tx = mux(state)
        1,
        0,
        shift_reg[0],
        1
        fallbackVal: 1

behavior on clk (posSen) or rst (posSen):
    if (rst):
        state = 0
        div_count = 0
        bit_count = 0
        shift_reg = 0
    else:
        when state:
            0:
                if (tx_start):
                    state = 1
                    shift_reg = tx_data
                    div_count = 0
            1:
                div_count = div_count + 1
                if (div_count == 8):
                    state = 2
                    div_count = 0
                    bit_count = 0
            2:
                div_count = div_count + 1
                if (div_count == 8):
                    shift_reg = shift_reg shf> 1
                    bit_count = bit_count + 1
                    div_count = 0
                    if (bit_count == 7):
                        state = 3
            3:
                div_count = div_count + 1
                if (div_count == 8):
                    state = 0
                    div_count = 0
            fallbackVal:
                state = 0
end behavior

end module
